#!/bin/sh
# Launcher for the librarian write MCP server (archive-librarian-mcp).
#
# The plugin can't know where thread-archive's venv lives, so resolve in order:
#   1. $THREAD_ARCHIVE_LIBRARIAN_MCP — explicit override, always wins
#   2. archive-librarian-mcp on PATH — pip/pipx installs
#   3. the clone layout — this script lives at <clone>/plugins/librarian/bin,
#      so the venv's console script is three levels up
set -eu

if [ -n "${THREAD_ARCHIVE_LIBRARIAN_MCP:-}" ]; then
    exec "$THREAD_ARCHIVE_LIBRARIAN_MCP" "$@"
fi

if command -v archive-librarian-mcp >/dev/null 2>&1; then
    exec archive-librarian-mcp "$@"
fi

clone_root=$(cd "$(dirname "$0")/../../.." && pwd)
if [ -x "$clone_root/.venv/bin/archive-librarian-mcp" ]; then
    exec "$clone_root/.venv/bin/archive-librarian-mcp" "$@"
fi

echo "librarian-mcp: archive-librarian-mcp not found." >&2
echo "Install thread-archive (its venv provides the script), then either put it on" >&2
echo "PATH or set THREAD_ARCHIVE_LIBRARIAN_MCP to its absolute path." >&2
exit 1
