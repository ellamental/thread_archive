<?xml version="1.0" encoding="UTF-8"?>
<!-- Template — `make install-backup-agent DEST=<path>` substitutes __REPO__,
     __DEST__, and __LOGDIR__ at install time. Do not install this file verbatim.

     Runs `archive nightly <DEST>` on a daily schedule — the whole protection
     pipeline as one command: mirror the JSONL truth dir to DEST (point it at a
     DIFFERENT disk/machine — for pre-retention history the truth log is the only
     copy), integrity-verify the live archive (the deep and hashes tiers fold in
     on age gates tracked in health.json, so a missed or failed escalated pass
     reruns the next night instead of waiting for the calendar), then a full
     restore drill every night (rebuild an index from the mirror in a throwaway
     home and smoke-read/search it — the proof the backup restores). Every stage
     runs and records its outcome in <home>/health.json; any stage failure POSTs
     to lab's /api/notify. A job that stops running entirely leaves those records
     stale — thread-monitor's archive-backup check alerts on that; this plist
     only has to run. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thread-archive.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/archive</string>
        <string>nightly</string>
        <string>__DEST__</string>
        <string>--notify-url</string>
        <string>http://127.0.0.1:8002/api/notify</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Daily at 04:00. A run also fires on load if the machine was asleep at 04:00. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <!-- A backup is I/O bound and not latency-sensitive; let it run nice. -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/backup-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__LOGDIR__/backup-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__REPO__/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
