# thread-archive watcher — the live-ingest LaunchAgent.
#
# Runs `thread-archive watch` straight from the repo venv: poll the local AI-tool
# stores (~/.claude, ~/.codex, ~/.grok, ~/.gemini, Cursor, OpenCode) and import
# new conversation content incrementally into the JSONL truth + SQLite index.
# No .app, no code-signing, no TCC — every watched store is a non-TCC path —
# and no backend: each source watcher calls the local importer directly.
#
# Day-to-day:
#   make install-agent     # (re)materialize the plist + (re)load the agent
#   make restart           # reload after a code edit (the venv runs source directly)
#   make logs
#   make uninstall-agent   # the watcher agent alone
#   make uninstall         # everything this machine carries (agents, MCP wiring,
#                          #   manifest) — never the conversations
#
# The `thread_archive` console script comes from `pip install -e .` (or `.[embeddings]`)
# into the repo venv. If $(ENTRY) is missing, install the package first.

LABEL     := com.thread-archive.watcher
REPO      := $(abspath $(CURDIR)/..)
ENTRY     := $(REPO)/.venv/bin/thread-archive
# Logs live next to the data (the archive home), not in the repo.
LOG_DIR   := $(HOME)/.thread/archive/logs

# The nightly durability pipeline (`thread-archive backup nightly`: backup → verify →
# restore drill) is scheduled by the package itself — `thread-archive service install
# --backup --dest <path>`, and the `thread_archive` setup wizard offers it.
# DEST must be a path launchd can reach unattended (a local disk); network
# shares and their remount/TCC machinery are an outer operator layer's
# concern, not this repo's.

.PHONY: all install-agent uninstall-agent uninstall restart logs status manifest

all: install-agent

# The plist itself is generated by the package (`thread-archive service install`, see
# src/thread_archive/_launchd.py) — the operator flow adds the thread-family
# manifest on top, which needs the repo checkout and never ships.
install-agent:
	@test -x $(ENTRY) || { echo "missing $(ENTRY) — run 'pip install -e .' into the repo venv first"; exit 1; }
	$(ENTRY) daemon install
	$(REPO)/.venv/bin/python $(CURDIR)/write-manifest.py
	@echo "to reload after a code edit:  make restart"
	@echo "to tail:                      make logs"

# (Re)write the family manifest alone — <home>/product.json, the discovery
# record consumers glob for (write-manifest.py is the reference for its
# shape). install-agent already does this; use this target after a version
# bump or a path change without reloading the agent. `make manifest WEB=0`
# omits the console/health surfaces (a box with no watcher agent serving :8787).
manifest:
	@test -x $(ENTRY) || { echo "missing $(ENTRY) — run 'pip install -e .' into the repo venv first"; exit 1; }
	$(REPO)/.venv/bin/python $(CURDIR)/write-manifest.py $(if $(filter 0,$(WEB)),--no-web)

uninstall-agent:
	$(ENTRY) daemon uninstall

# The inverse of install-agent, and then some: the package's own removal verb
# takes the agents, the MCP client wiring, the manifest written above, and the
# monitor heartbeat. The archive itself is never touched — deleting that is the
# operator's, on the directory the run names.
uninstall:
	$(ENTRY) uninstall

# Code edits go live on a plain restart (the venv runs source directly).
# Plist changes need a full reload — re-run `make install-agent` for those.
restart:
	$(ENTRY) daemon restart

status:
	@$(ENTRY) daemon status

logs:
	tail -F $(LOG_DIR)/watcher-stdout.log $(LOG_DIR)/watcher-stderr.log
