{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cursor_export_v1",
  "title": "Cursor Export v1",
  "description": "Cursor IDE chat export format (from cursor_export tool)",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "cursor"
    },
    "export_version": {
      "type": "string"
    },
    "export_date": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "conversations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conversation"
      }
    }
  },
  "definitions": {
    "conversation": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation ID"
        },
        "title": {
          "type": ["string", "null"],
          "description": "Chat title"
        },
        "workspace_hash": {
          "type": "string",
          "description": "Hash identifying the workspace"
        },
        "workspace_name": {
          "type": ["string", "null"],
          "description": "Human-readable workspace name"
        },
        "workspace_uri": {
          "type": ["string", "null"],
          "description": "Path to the workspace"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/message"
          }
        },
        "bubbles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bubble"
          },
          "description": "Alternative message format (raw Cursor format)"
        }
      }
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "system", "tool"],
          "description": "Message author role"
        },
        "content": {
          "type": ["string", "null"],
          "description": "Message text content"
        },
        "content_blocks": {
          "type": "array",
          "description": "Pre-parsed content blocks"
        },
        "created_at": {
          "type": ["string", "null"],
          "description": "ISO timestamp"
        },
        "tool_calls": {
          "type": "array",
          "description": "Tool/function calls made"
        },
        "tool_results": {
          "type": "array",
          "description": "Results from tool calls"
        },
        "model": {
          "type": ["string", "null"],
          "description": "Model used for response"
        }
      }
    },
    "bubble": {
      "type": "object",
      "description": "Raw Cursor bubble format",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "ai"],
          "description": "Bubble type"
        },
        "text": {
          "type": ["string", "null"],
          "description": "Message text"
        },
        "rawText": {
          "type": ["string", "null"],
          "description": "Raw text before processing"
        },
        "codeBlocks": {
          "type": "array",
          "description": "Code blocks in the message"
        },
        "selections": {
          "type": "array",
          "description": "Code selections referenced"
        },
        "messageId": {
          "type": ["string", "integer"],
          "description": "Message identifier"
        },
        "relevantFiles": {
          "type": "array",
          "description": "Files relevant to this message"
        },
        "capabilityStatuses": {
          "type": "array"
        }
      }
    }
  }
}
