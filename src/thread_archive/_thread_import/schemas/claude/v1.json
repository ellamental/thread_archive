{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claude_export_v1",
  "title": "Claude Export v1",
  "description": "Claude data export format with conversations, memories, and projects",
  "type": "object",
  "properties": {
    "conversations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/conversation"
      }
    },
    "memories": {
      "type": "object",
      "properties": {
        "project_memories": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/project"
      }
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/user"
      }
    }
  },
  "definitions": {
    "conversation": {
      "type": "object",
      "required": ["uuid"],
      "properties": {
        "uuid": {
          "type": "string",
          "description": "Unique conversation identifier"
        },
        "name": {
          "type": ["string", "null"],
          "description": "Conversation title"
        },
        "summary": {
          "type": ["string", "null"],
          "description": "Conversation summary"
        },
        "created_at": {
          "type": ["string", "null"],
          "description": "ISO timestamp"
        },
        "updated_at": {
          "type": ["string", "null"],
          "description": "ISO timestamp"
        },
        "account": {
          "type": "object",
          "properties": {
            "uuid": {"type": "string"}
          }
        },
        "project": {
          "type": ["object", "null"],
          "properties": {
            "uuid": {"type": "string"}
          }
        },
        "chat_messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/message"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["uuid", "sender"],
      "properties": {
        "uuid": {
          "type": "string",
          "description": "Unique message identifier"
        },
        "sender": {
          "type": "string",
          "enum": ["human", "assistant"],
          "description": "Message author"
        },
        "text": {
          "type": ["string", "null"],
          "description": "Legacy text field"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contentBlock"
          },
          "description": "Content blocks"
        },
        "created_at": {
          "type": ["string", "null"],
          "description": "ISO timestamp"
        },
        "updated_at": {
          "type": ["string", "null"],
          "description": "ISO timestamp"
        },
        "attachments": {
          "type": "array"
        },
        "files": {
          "type": "array"
        }
      }
    },
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "tool_use", "tool_result", "token_budget"],
          "description": "Block type"
        },
        "text": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "content": {},
        "is_error": {
          "type": "boolean"
        },
        "start_timestamp": {
          "type": ["string", "null"]
        },
        "stop_timestamp": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        },
        "display_content": {}
      }
    },
    "project": {
      "type": "object",
      "required": ["uuid"],
      "properties": {
        "uuid": {
          "type": "string"
        },
        "name": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "user": {
      "type": "object",
      "required": ["uuid"],
      "properties": {
        "uuid": {
          "type": "string"
        },
        "full_name": {
          "type": ["string", "null"]
        },
        "email": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
