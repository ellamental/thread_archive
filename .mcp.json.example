{
  "_comment": "Template. Copy to .mcp.json and replace ABSOLUTE_REPO_PATH with this clone's absolute path (the install step does this for you). This is the read-only retrieval server (thread_search / thread_read). The curation write surface is the thread-librarian package (its own repo) — installing its plugin brings its own server wiring.",
  "mcpServers": {
    "thread-archive": {
      "command": "ABSOLUTE_REPO_PATH/.venv/bin/archive-mcp",
      "env": { "THREAD_ARCHIVE_HOME": "~/.thread/archive" }
    }
  }
}
