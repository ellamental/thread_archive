# Keep the build context lean and never bake host/private state into the image.
.git/
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# archive data + machine-specific config — never ship these into the image
data/
truth/
index.db
index.db-*
*.sqlite
/.mcp.json

.DS_Store
